    {
      "name": "Create Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-11-20T10:00:00.000Z\",\n  \"endTime\": \"2026-11-20T11:00:00.000Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/sessions"
        },
        "description": "Create a session for an existing teacher. Set {{teacherId}} to a Teacher _id from MongoDB or the seed script. Expected response: HTTP 201 with success=true, status=AVAILABLE, userId=null, and completedAt=null."
      }
    },
    {
      "name": "Get Available Sessions by Date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}"
        },
        "description": "dateTimestamp is a Unix timestamp in milliseconds. Its UTC calendar date is queried from 00:00:00.000 inclusive to the next UTC midnight exclusive."
      },
      "response": [
        {
          "name": "Available Sessions",
          "originalRequest": {
